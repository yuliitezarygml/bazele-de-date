        </mxCell>
        <mxCell id="29" value="Cheile compuse se citesc împreună: toate atributele marcate PK formează cheia primară. O săgeată către o tabelă indică referința la cheia ei; cazul FK compusă OFERTA este explicat în raport." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#546477;fontStyle=0;" vertex="1" parent="1">
