        <mxCell id="22" value="Referințele FK sunt înscrise în tabele pentru a evita intersectarea liniilor. PK/FK marchează cheia partajată a unei subclase sau componentele unei asocieri." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#546477;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1270" width="1570" height="52" as_="geometry" as="geometry" />
        </mxCell>
        <mxCell id="23" value="Cheile compuse se citesc împreună: toate atributele marcate PK formează cheia primară. O săgeată către o tabelă indică referința la cheia ei; cazul FK compusă OFERTA este explicat în raport." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#546477;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1350" width="1570" height="60" as_="geometry" as="geometry" />
        </mxCell>
        <mxCell id="24" value="NOT NULL, UNIQUE, CHECK și detaliile de participare sunt enumerate în raport. Schema SQL și datele de exemplu permit verificarea separată a tuturor celor cinci sarcini." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#546477;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1440" width="1570" height="60" as_="geometry" as="geometry" />
        </mxCell>
