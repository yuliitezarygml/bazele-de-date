        </mxCell>
        <mxCell id="28" value="NOT NULL, UNIQUE, CHECK și detaliile de participare sunt enumerate în raport. Schema SQL și datele de exemplu permit verificarea separată a tuturor celor cinci sarcini." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#546477;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="1440" width="1570" height="60" as_="geometry" as="geometry" />
