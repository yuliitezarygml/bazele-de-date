        <mxCell id="n73" parent="1" value="Toate tabelele sunt conectate prin linii FK → PK. PK compusă = toate rândurile marcate PK. PK/FK = aceeași cheie este identificator și referință. ? = NULL permis. Fiecare rând și conector este editabil." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#536579;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="65" y="2013.0" width="4070" height="45" />
        </mxCell>
        <mxCell id="n74" parent="1" value="Săgeata pleacă din rândul FK și ajunge în rândul cheii referite. Constrângerile UNIQUE și CHECK rămân cele din schema SQL." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#536579;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="65" y="2070.0" width="4070" height="48" />
        </mxCell>
