        <mxCell id="n131" parent="1" value="norma_poluare: restricții de circulație · metoda_plata: evidența încasării · telefon_contact: predare și garanție." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#536579;fontStyle=0;" vertex="1">
