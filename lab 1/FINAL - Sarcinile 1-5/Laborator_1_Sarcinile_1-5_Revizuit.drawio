        <mxCell id="n143" parent="1" value="volum_cm3: capacitatea transportului · fragil: manipulare specială · durata_estimata_ore: estimarea livrării." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=20;fontColor=#536579;fontStyle=0;" vertex="1">
