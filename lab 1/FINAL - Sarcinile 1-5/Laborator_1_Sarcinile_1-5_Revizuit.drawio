        <mxCell id="n133" parent="1" value="Entități = dreptunghiuri · Atribute = elipse · Asocieri = romburi · PK = subliniere continuă · FK = subliniere întreruptă · Cardinalități: 1:N, N:1, 1:1." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#536579;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="65" y="2863" width="4070" height="45" />
        </mxCell>
        <mxCell id="n134" parent="1" value="ISA = specializare EER; d = disjunctă, o = suprapusă. Cele două atribute FK ale fiecărei asocieri referă identificatorii participanților; implementarea efectivă este în tabele." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#536579;fontStyle=0;" vertex="1">
