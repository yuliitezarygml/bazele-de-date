        </mxCell>
        <mxCell id="n81" parent="1" value="ISA = specializare EER; d = disjunctă, o = suprapusă. Cele două atribute FK ale fiecărei asocieri referă identificatorii participanților; implementarea efectivă este în tabele." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#536579;fontStyle=0;" vertex="1">
