        <mxCell id="n17" parent="1" value="Toate tabelele sunt conectate prin linii FK → PK. PK compusă = toate rândurile marcate PK. PK/FK = cheie partajată. ? = NULL permis. Fiecare rând și conector este editabil." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#536579;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="65" y="1113" width="1970" height="45" />
        </mxCell>
        <mxCell id="n18" parent="1" value="ANGAJAT_FORMARE.id_mentor este FK către MENTOR.id_mentor. În diagramă sunt două tabele distincte, conectate prin aceeași cheie PK–FK." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#536579;fontStyle=0;" vertex="1">
          <mxGeometry as="geometry" x="65" y="1170" width="1970" height="48" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
