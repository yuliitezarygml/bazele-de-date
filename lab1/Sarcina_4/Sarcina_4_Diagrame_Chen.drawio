        <mxCell id="legend" value="Dreptunghi = entitate • romb = asociere • oval = atribut • subliniat = PK • albastru = FK • oval punctat = derivat • (min,max) = participare" style="text;html=1;whiteSpace=wrap;fillColor=white;strokeColor=none;fontColor=#334155;fontSize=17;fontStyle=0;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;shadow=0;dashed=0;" vertex="1" parent="1">
