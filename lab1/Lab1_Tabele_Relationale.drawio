        <mxCell id="legend" value="[PK] cheie primară • [FK] cheie străină • [PK/FK] cheie primară și străină • [UQ] unic • verde pal = atribut suplimentar • date fictive" style="text;html=1;whiteSpace=wrap;fillColor=white;strokeColor=none;fontColor=#334155;fontSize=17;fontStyle=0;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;strokeWidth=1;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="105" width="6273" height="55" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Un client poate avea ambele roluri: expeditor și destinatar. Tipul fizică/juridică este atribut al clientului. SCANARE materializează evenimentul dintre colet, punct și angajat. Segmentele unei rute sunt ordonate și consecutive; intrările și ieșirile sunt evenimente separate.&lt;br&gt;ATRIBUTE SUPLIMENTARE: email: Transmiterea notificărilor clientului. • status: Urmărirea stării curente a coletului. • functie: Identificarea responsabilității angajatului." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=17;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=middle;spacing=6;strokeWidth=1;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="3500" width="6273" height="145" as="geometry" />
        </mxCell>
