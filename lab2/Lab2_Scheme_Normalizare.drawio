          <mxGeometry x="12" y="53" width="416" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b4_r1" value="e" style="text;html=1;align=left;fontColor=#233b50;fontSize=16;" vertex="1" parent="b4">
          <mxGeometry x="12" y="83" width="416" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b4_r2" value="FK g → G" style="text;html=1;align=left;fontColor=#233b50;fontSize=16;" vertex="1" parent="b4">
          <mxGeometry x="12" y="113" width="416" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="Dependențe: a → c,g; b → e,g; ab → d; c → f; g → h. Cheie: {a,b}. Inițial: 1FN, nu 2FN. Sinteza păstrează ambele dependențe spre g și o relație care conține cheia inițială." style="html=1;whiteSpace=wrap;fillColor=#f0f5fa;strokeColor=#d4dfeb;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#233b50;" vertex="1" parent="1">
          <mxGeometry x="60" y="175" width="1920" height="125" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="A, B, C, G și AB sunt în FNBC. Cheia {a,b} este în AB: sinteză fără pierderi, confirmată prin chase. Pentru fiecare pereche din AB, valorile g referite prin A și B trebuie să coincidă." style="html=1;whiteSpace=wrap;fillColor=#f0f5fa;strokeColor=#d4dfeb;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#233b50;" vertex="1" parent="1">
          <mxGeometry x="60" y="1120" width="1920" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
