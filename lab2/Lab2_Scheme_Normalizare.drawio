        <mxCell id="note0" value="Eliminăm dependența tranzitivă prin Nr_client. Clienti păstrează identitatea clientului; Comenzi păstrează doar referința. Tabelele și cele 6 linii de comandă sunt prezentate separat, cu datele din enunț." style="html=1;whiteSpace=wrap;fillColor=#f0f5fa;strokeColor=#d4dfeb;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#233b50;" vertex="1" parent="1">
          <mxGeometry x="60" y="175" width="1920" height="125" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="Toate dependențele sunt păstrate. Determinanții netriviali sunt chei; rezultatul este în FNBC. Joncțiunea celor 4 tabele reconstruiește exact cele 6 tupluri din 1FN." style="html=1;whiteSpace=wrap;fillColor=#f0f5fa;strokeColor=#d4dfeb;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#233b50;" vertex="1" parent="1">
