        <mxCell id="sub" value="Joncțiunea X ⋈ Y se face pe Nr_credite. Acest atribut nu determină nici studentul, nici cursul." style="text;html=1;whiteSpace=wrap;align=left;fontColor=#233b50;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1920" height="65" as="geometry" />
        </mxCell>
        <mxCell id="note0" value="A are 5 tupluri, X are 5, Y are 3. Cele 3 linii cu 6 credite din X se potrivesc cu câte 2 cursuri din Y: 2×1 + 3×2 = 8 tupluri după joncțiune." style="html=1;whiteSpace=wrap;fillColor=#f0f5fa;strokeColor=#d4dfeb;align=left;verticalAlign=top;spacing=14;fontSize=17;fontColor=#233b50;" vertex="1" parent="1">
